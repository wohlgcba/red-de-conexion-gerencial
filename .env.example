VITE_SUPABASE_URL=https://pnhskmlejdaklwkvasxp.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Authenticated institutional structure and verified Directory links.
# Use mock only for explicitly labeled fictional demonstrations.
# Use local for an offline institutional structure without responsibilities.
VITE_ORGANIZATION_SOURCE=supabase

# Private server variables. Never use the VITE_ prefix for these credentials.
# Local values can live in ignored .env.dotacion.local; production uses Vercel env.
SUPABASE_SERVICE_ROLE_KEY=
DOTACION_DB_HOST=
DOTACION_DB_PORT=3306
DOTACION_DB_USER=
DOTACION_DB_PASSWORD=
DOTACION_DB_NAME=
DOTACION_DB_TABLE=dotacion_gcba_prueba
# Optional trusted CA PEM (escaped newlines supported). TLS verification is required.
DOTACION_DB_CA=
# strict: normal CA + DNS-name verification (default).
# private-ca: installation CA explicitly trusted for an auto-generated MySQL
# certificate without a DNS SAN. Requires exactly one CA, its SHA-256 fingerprint
# and the exact host:port. Chain verification remains enabled in both modes.
DOTACION_DB_TLS_MODE=strict
DOTACION_DB_CA_SHA256=
DOTACION_DB_CA_ENDPOINT=
